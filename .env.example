XVECTOR_USERNAME=root
XVECTOR_PASSWORD=Xvector
XVECTOR_DATA_DIR=/data
# Host path bind-mounted to container /data (compose)
XVECTOR_HOST_DATA_DIR=./data
XVECTOR_HTTP_PORT=19530
XVECTOR_WRITER_URL=http://writer:18081
XVECTOR_READER_URL=http://reader:18082
XVECTOR_WRITER_PORT=18081
XVECTOR_READER_PORT=18082
XVECTOR_AUTO_LOAD=false
XVECTOR_READER_REFRESH_SECONDS=10
XVECTOR_META_REFRESH_SECONDS=10
XVECTOR_INTERNAL_TOKEN=
XVECTOR_LOG_LEVEL=INFO
XVECTOR_PASSWORD_ITERATIONS=200000
# Optional S3 for import
# XVECTOR_S3_ENDPOINT=
# XVECTOR_S3_ACCESS_KEY=
# XVECTOR_S3_SECRET_KEY=
# XVECTOR_S3_BUCKET=
# XVECTOR_S3_REGION=
# XVECTOR_S3_SECURE=false

# API docs merge + access log (Gateway)
XVECTOR_OPENAPI_REFRESH_SECONDS=60
XVECTOR_OPENAPI_REFRESH_RETRIES=3
XVECTOR_OPENAPI_REFRESH_RETRY_INTERVAL_SECONDS=1
XVECTOR_OPENAPI_FETCH_TIMEOUT_SECONDS=5
XVECTOR_DOCS_ENABLED=true
XVECTOR_REDOC_ENABLED=false
XVECTOR_WRITER_DOCS_UI=false
XVECTOR_READER_DOCS_UI=false
XVECTOR_OPENAPI_INCLUDE_INTERNAL=false
XVECTOR_ACCESS_LOG_ENABLED=true
